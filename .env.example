# Example environment variables for projet_eseo
# Copy this file to .env and fill values before running locally

# Application
APP_ENV=development
APP_URL=http://localhost:8080
API_BASE=/api

# Database (used by backend)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eseo_db
DB_USERNAME=eseo_user
DB_PASSWORD=change_me

# Session / security
SESSION_SECRET=change_this_secret

# Mail (optional)
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=webmaster@example.com
